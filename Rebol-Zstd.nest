github: facebook/zstd /v1.5.7

version: 1.5.7

compiler: clang
arch:     x64
optimize: 2

;define: USE_TRACES

;- options common for all Rebol extensions ----------------------
#if Windows? [
	define: TO_WINDOWS
	define: _CRT_SECURE_NO_WARNINGS
	set-env CMAKE_GEN: {-G "Visual Studio 17 2022"}
]
#if macOS?   [
	define: TO_OSX
	define: HAS_BOOL
	set-env CMAKE_GEN: ""
]
#if Linux? [
	define: TO_LINUX
	compiler: gcc
	set-env CMAKE_GEN: ""
	cflags: -fvisibility=hidden
]

define: ENDIAN_LITTLE
;; Selects the amalgamated `rebol-extension.h` in the generated header.
define: REB_EXT

target-x86: [
	;- On linux needs:  sudo apt install gcc-multilib g++-multilib
	arch: x86
	set-env SISKIN_INSTALL_PREFIX: "$SISKIN_INSTALL/x86/$INSTALL_SUFFIX"
	#if macOS?   [ fail "It is not possible to make 32bit build on macos" ]
	#if Posix?   [
		set CMAKE_ARCH: "-DCMAKE_C_FLAGS=-m32 -DCMAKE_CXX_FLAGS=-m32"
		include: %$SISKIN_INSTALL_PREFIX/include/
		library: %$SISKIN_INSTALL_PREFIX/lib/
	]
	#if Windows? [
		flags: "-arch x86_64"
		include: %$SISKIN_INSTALL_PREFIX/include/
		library: %$SISKIN_INSTALL_PREFIX/Win32/vc17/lib/
		set CMAKE_ARCH: "-A Win32"
	]
	set CMAKE_ARCH: [
		"$CMAKE_ARCH"
		"-DCMAKE_INSTALL_PREFIX=$SISKIN_INSTALL_PREFIX"
	]
]
target-x64: [
	arch: x64
	set-env SISKIN_INSTALL_PREFIX: "$SISKIN_INSTALL/x64/$INSTALL_SUFFIX"
	defines: [
		_FILE_OFFSET_BITS=64
		__LP64__ ; has long (integer) 64 bits
	]
	#if Windows? [ set CMAKE_ARCH: "-A x64" ]
	#if Posix?   [ set CMAKE_ARCH: ""]
	#if macOS?   [
		flags: ["-arch x86_64"] 
		set CMAKE_ARCH: [
			"-DCMAKE_OSX_SYSROOT=macosx"
			"-DCMAKE_OSX_ARCHITECTURES=x86_64"
			"-DCMAKE_APPLE_SILICON_PROCESSOR=x86_64" ;; make CMake treat the build as x86_64, not the arm64 host
			"-DCMAKE_OSX_DEPLOYMENT_TARGET=10.9"
		]
	]
	#if Posix?   [
		include: %$SISKIN_INSTALL_PREFIX/include/
		library: %$SISKIN_INSTALL_PREFIX/lib/
	]
	#if Windows? [
		include: %$SISKIN_INSTALL_PREFIX/include/
		library: %$SISKIN_INSTALL_PREFIX/x64/vc17/lib/
	]
	set CMAKE_ARCH: [
		"$CMAKE_ARCH"
		"-DCMAKE_INSTALL_PREFIX=$SISKIN_INSTALL_PREFIX"
	]
]
target-arm64: [
	arch: arm64
	set-env SISKIN_INSTALL_PREFIX: "$SISKIN_INSTALL/arm64/$INSTALL_SUFFIX"
	define: _FILE_OFFSET_BITS=64
	define: __LP64__ ; has long (integer) 64 bits
	define: __arm64__
	#if Posix? [
		#either macOS? [
			flags: "-target arm64-apple-darwin"
			set CMAKE_ARCH: [
				"-DCMAKE_OSX_SYSROOT=macosx"
				"-DCMAKE_OSX_ARCHITECTURES=arm64"
				"-DCMAKE_OSX_DEPLOYMENT_TARGET=11.0"
			]
		][
			;- Needs:  sudo apt install gcc-aarch64-linux-gnu g++-aarch64-linux-gnu
			set CMAKE_ARCH: [
				"-DCMAKE_SYSTEM_NAME=Linux"
				"-DCMAKE_SYSTEM_PROCESSOR=aarch64"
				"-DCMAKE_C_COMPILER=aarch64-linux-gnu-gcc"
				"-DCMAKE_CXX_COMPILER=aarch64-linux-gnu-g++"
			]
		]
		include: %$SISKIN_INSTALL_PREFIX/include/
		library: %$SISKIN_INSTALL_PREFIX/lib/
	]
	#if Windows? [
		set CMAKE_ARCH: "-A arm64" 
		include: %$SISKIN_INSTALL_PREFIX/include/
		library: %$SISKIN_INSTALL_PREFIX/aarch64/vc17/lib/
	]
	set CMAKE_ARCH: [
		"$CMAKE_ARCH"
		"-DCMAKE_INSTALL_PREFIX=$SISKIN_INSTALL_PREFIX"
	]
]
;----------------------------------------------------------------


;----------------------------------------------------------------
;- extension sources are built out of the Rebol tree -------------
;; Selects the amalgamated `rebol-extension.h` in the generated header.
define: REB_EXT

r3-extension: [
	flags: shared
	strip: on
	source: %src/
	files: only [
		%zstd.c
		%zstd-commands.c
		%gen-zstd.c
	]
	#if macOS? [
		compiler: clang
		lflag:  "-dynamiclib"
		cflag:  "-mmacosx-version-min=10.9"
		;; Export only the extension entry points.
		lflag: "-Wl,-exported_symbol,_RX_Init -Wl,-exported_symbol,_RX_Quit -Wl,-exported_symbol,_RX_Call -Wl,-exported_symbol,_RX_Abi"
		lflag: "-Wl,-dead_strip"
	]
	#if Posix? [
		cflags: [-fPIC -pthread]
		libraries: [%pthread]
	]
	#if Linux? [
		lflag: "-Wl,--exclude-libs,ALL"
		lflag: "-Wl,--gc-sections"
	;	library: %dl
		library: %pthread
	]
	#if Windows? [
		upx: on
	]
	;- generate the extension header and command table -------------
	;; Produces %src/gen-zstd.h and %src/gen-zstd.c, and refreshes
	;; %README.md's reference section (make-extension.r3 0.7.0+ only
	;; touches the README when --readme is passed).
	do %make-extension.r3 [%src/zstd.reb --readme]
]

link-static: [
	set-env CMAKE_LINK: [
		"-DZSTD_BUILD_STATIC=ON"
		"-DZSTD_BUILD_SHARED=OFF"
	]
	set-env INSTALL_SUFFIX: "static"
	#either windows? [
		library: %zstd_static
	][	library: %zstd]
]
link-shared: [
	set-env CMAKE_LINK: [
		"-DZSTD_BUILD_STATIC=OFF"
		"-DZSTD_BUILD_SHARED=ON"
	]
	set-env INSTALL_SUFFIX: "shared"
	library: %zstd
]
cmake-spec: [
	set-env CMAKE_COMMON: [
		"-DCMAKE_BUILD_TYPE=Release"
		"-DCMAKE_VERBOSE_MAKEFILE=OFF"
		"-DZSTD_PROGRAMS_LINK_SHARED=OFF"
		"-DZSTD_BUILD_PROGRAMS=OFF"
		"-DZSTD_BUILD_TESTS=OFF"
		"-DZSTD_BUILD_CONTRIB=OFF"
		"-DZSTD_LEGACY_SUPPORT=OFF"
	;- Above defined based on target
		"$CMAKE_ARCH"
		"$CMAKE_LINK"
	]
]

eggs: [
	"Cmake Zstd static - x86" [
		name: %cmake-zstd-x86
		:link-static :target-x86 :cmake-spec
		cmd "cmake --fresh -B $SISKIN_TEMP/zstd-x86 $CMAKE_GEN -S zstd/build/cmake $CMAKE_COMMON"
		cmd "cmake --build    $SISKIN_TEMP/zstd-x86 --config release -j 8"
		cmd "cmake --install  $SISKIN_TEMP/zstd-x86 --config release"
	]
	"Cmake Zstd static - x64" [
		name: %cmake-zstd-x64
		:link-static :target-x64 :cmake-spec
		cmd "cmake --fresh -B $SISKIN_TEMP/zstd-x64 $CMAKE_GEN -S zstd/build/cmake $CMAKE_COMMON"
		cmd "cmake --build    $SISKIN_TEMP/zstd-x64 --config release -j 8"
		cmd "cmake --install  $SISKIN_TEMP/zstd-x64 --config release"
	]
	"Cmake Zstd static - arm64" [
		name: %cmake-zstd-arm64
		:link-static :target-arm64 :cmake-spec
		cmd "cmake --fresh -B $SISKIN_TEMP/zstd-arm64 $CMAKE_GEN -S zstd/build/cmake $CMAKE_COMMON"
		cmd "cmake --build    $SISKIN_TEMP/zstd-arm64 --config release -j 8"
		cmd "cmake --install  $SISKIN_TEMP/zstd-arm64 --config release"
	]

	"Rebol Zstd static extension: x86" [
		name: %zstd-x86
		:link-static :target-x86 :r3-extension
	]
	"Rebol Zstd static extension: x64" [
		name: %zstd-x64
		:link-static :target-x64 :r3-extension
	]
	"Rebol Zstd static extension: arm64" [
		name: %zstd-arm64
		:link-static :target-arm64 :r3-extension
	]

	"Cmake Zstd shared - x86" [
		name: %cmake-zstd-shared-x86
		:link-shared :target-x86 :cmake-spec
		cmd "cmake --fresh -B $SISKIN_TEMP/zstd-x86-shared $CMAKE_GEN -S zstd/build/cmake $CMAKE_COMMON"
		cmd "cmake --build    $SISKIN_TEMP/zstd-x86-shared --config release -j 8"
		cmd "cmake --install  $SISKIN_TEMP/zstd-x86-shared --config release"
	]
	"Cmake Zstd shared - x64" [
		name: %cmake-zstd-shared-x64
		:link-shared :target-x64 :cmake-spec
		cmd "cmake --fresh -B $SISKIN_TEMP/zstd-x64-shared $CMAKE_GEN -S zstd/build/cmake $CMAKE_COMMON"
		cmd "cmake --build    $SISKIN_TEMP/zstd-x64-shared --config release -j 8"
		cmd "cmake --install  $SISKIN_TEMP/zstd-x64-shared --config release"
	]
	"Cmake Zstd shared - arm64" [
		name: %cmake-zstd-shared-arm64
		:link-shared :target-arm64 :cmake-spec
		cmd "cmake --fresh -B $SISKIN_TEMP/zstd-arm64-shared $CMAKE_GEN -S zstd/build/cmake $CMAKE_COMMON"
		cmd "cmake --build    $SISKIN_TEMP/zstd-arm64-shared --config release -j 8"
		cmd "cmake --install  $SISKIN_TEMP/zstd-arm64-shared --config release"
	]
	"Rebol Zstd shared extension: x86" [
		name: %zstd-shared-x86
		:link-shared :target-x86 :r3-extension
	]
	"Rebol Zstd shared extension: x64" [
		name: %zstd-shared-x64
		:link-shared :target-x64 :r3-extension
	]
	"Rebol Zstd shared extension: arm64" [
		name: %zstd-shared-arm64
		:link-shared :target-arm64 :r3-extension
	]
]
